# Generates build_id.cpp at BUILD time (not configure time) so the embedded
# string refreshes on every build/link (the stale __DATE__ banner trap).
#
# Usage: cmake -DOUT=<path/to/build_id.cpp> -P gen_build_id.cmake

if(NOT DEFINED OUT)
    message(FATAL_ERROR "gen_build_id.cmake: pass -DOUT=<output file>")
endif()

string(TIMESTAMP _ts "%Y-%m-%d %H:%M:%S")

file(WRITE "${OUT}"
"// Auto-generated by cmake/gen_build_id.cmake at build time. DO NOT EDIT.
extern const char* const g_build_id;
const char* const g_build_id = \"NATIVEEE-BUILD-ID ${_ts}\";
")
