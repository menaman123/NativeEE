{
  "schema": 1,
  "file": "nativeee.ini",
  "bindings_file": "bindings.ini",
  "legacy_files": [
    "ps2r.ini",
    "display.ini"
  ],
  "resolution": [
    "--config <file>",
    "<executable folder>/nativeee.ini",
    "<user data>/nativeee.ini"
  ],
  "grammar": {
    "line": "key = value",
    "sections": "a [section] header scopes the short key name; the flat section.key form is read too",
    "comments": "# or ; to the end of the line",
    "write": "replace the key's line in place; a new key goes after the last key of its [section], or in a new [section] appended at the end; write the whole file to a temporary and rename it",
    "booleans": "on | off"
  },
  "settings": [
    {
      "key": "audio.enabled",
      "section": "audio",
      "name": "enabled",
      "type": "bool",
      "default": "on",
      "kind": "switch",
      "user_facing": false
    },
    {
      "key": "audio.interpolation",
      "section": "audio",
      "name": "interpolation",
      "type": "enum",
      "default": "linear",
      "kind": "choice",
      "user_facing": true,
      "values": [
        "linear",
        "gaussian"
      ],
      "label": "Sound smoothing",
      "help": "How the console's sound samples are smoothed. Console-accurate matches the original hardware; Standard is a little brighter.",
      "choices": [
        {
          "value": "linear",
          "label": "Standard"
        },
        {
          "value": "gaussian",
          "label": "Console-accurate"
        }
      ]
    },
    {
